<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/widget_list_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="#08090B"
  android:orientation="vertical"
  android:padding="10dp">

  <TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="CineLog"
    android:textColor="#E23D3D"
    android:textSize="11sp"
    android:textStyle="bold" />

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_marginTop="8dp"
    android:layout_weight="1"
    android:orientation="horizontal">

    <LinearLayout
      android:id="@+id/row0"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_marginEnd="6dp"
      android:layout_weight="1"
      android:orientation="vertical">
      <ImageView android:id="@+id/poster0" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:contentDescription="@string/widget_list_description" android:scaleType="centerCrop" />
      <TextView android:id="@+id/row0_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:paddingTop="4dp" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" />
      <TextView android:id="@+id/row0_sub" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textColor="#C5C8CE" android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
      android:id="@+id/row1"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_marginStart="6dp"
      android:layout_weight="1"
      android:orientation="vertical">
      <ImageView android:id="@+id/poster1" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:contentDescription="@string/widget_list_description" android:scaleType="centerCrop" />
      <TextView android:id="@+id/row1_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:paddingTop="4dp" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" />
      <TextView android:id="@+id/row1_sub" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textColor="#C5C8CE" android:textSize="11sp" />
    </LinearLayout>
  </LinearLayout>

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_marginTop="8dp"
    android:layout_weight="1"
    android:orientation="horizontal">

    <LinearLayout
      android:id="@+id/row2"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_marginEnd="6dp"
      android:layout_weight="1"
      android:orientation="vertical">
      <ImageView android:id="@+id/poster2" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:contentDescription="@string/widget_list_description" android:scaleType="centerCrop" />
      <TextView android:id="@+id/row2_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:paddingTop="4dp" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" />
      <TextView android:id="@+id/row2_sub" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textColor="#C5C8CE" android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
      android:id="@+id/row3"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_marginStart="6dp"
      android:layout_weight="1"
      android:orientation="vertical">
      <ImageView android:id="@+id/poster3" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:contentDescription="@string/widget_list_description" android:scaleType="centerCrop" />
      <TextView android:id="@+id/row3_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:paddingTop="4dp" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" />
      <TextView android:id="@+id/row3_sub" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textColor="#C5C8CE" android:textSize="11sp" />
    </LinearLayout>
  </LinearLayout>
</LinearLayout>
